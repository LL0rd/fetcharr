{
  "name": "@fetcharr/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.mjs --external:better-sqlite3 --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fetcharr/db": "workspace:*",
    "@fetcharr/shared": "workspace:*",
    "croner": "^10.0.1",
    "execa": "^10.0.1",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
